# Frontend API base URL. Leave empty to infer http(s)://<current-host>:8080/api.
REACT_APP_API_BASE_URL=http://localhost:8080/api

# Shell WebSocket URL. Leave empty to infer ws(s)://<current-host>:8080/api/shell.
REACT_APP_SHELL_WS_URL=ws://localhost:8080/api/shell

# Frontend API timeout in milliseconds.
REACT_APP_API_TIMEOUT_MS=15000
