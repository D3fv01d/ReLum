{
  "name": "relum",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "lab:build": "docker build -f labs/relum-lab/Dockerfile -t relum/local-lab:latest .",
    "lab:serve": "RELUM_KNOWLEDGE_ID=sql-injection RELUM_SECTION_TITLE=字符型SQL注入 RELUM_FLAG='flag{relum_local_development}' node labs/relum-lab/src/server.js",
    "lab:test": "node --test labs/relum-lab/src/*.test.js",
    "verify": "bash scripts/verify.sh",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "react-scripts": "^5.0.1",
    "tailwindcss": "^3.4.19"
  }
}
