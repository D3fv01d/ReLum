# HTTP server port.
PORT=8080

# Comma-separated browser origins allowed to call the API and Shell WebSocket.
# Use explicit origins in production, for example: https://relum.example.com
CORS_ORIGIN=http://localhost:3000

# Express JSON request body limit.
JSON_BODY_LIMIT=1mb

# Target API rate limit.
TARGET_RATE_LIMIT_WINDOW_MS=60000
TARGET_RATE_LIMIT_MAX=120

# Shell mode and safety limits.
SHELL_ACCESS_ENABLED=false
SHELL_COMMAND_MAX_LENGTH=2000
SHELL_WS_MAX_PAYLOAD=8192

# Docker shell working directory when SHELL_ACCESS_ENABLED=true.
RELUM_DOCKER_SHELL_CWD=/app

# Docker command timeout in milliseconds.
DOCKER_COMMAND_TIMEOUT_MS=10000
